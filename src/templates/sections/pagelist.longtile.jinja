{#
pagelist.longtile.jinja

This section displays N-number of sub-items in a full-width, vertically stacked format.
Each tile spans the entire width of the page and includes title, description, and stories metadata.
The image is 20% wider than standard tiles, and stories appear on hover.

Example of the settings allowed in the yaml config "section" dictionary:

- type: 'pagelist.longtile'   # jinja html template as found in /src/templates/sections/[type].jinja
  heading: "Latest Projects"  # section header
  subfolder: "projects"       # subfolder under project root to sort, iterate, and produce pagelist items, one item per page found
  image: true                 # if false, skip image.  If true, use the md Front Matter "image".  If true but no image defined, default to logo.png
  sort: "date_desc"           # sort order of files found under the subfolder.  Allows format: [date|title|author]_[asc|desc]
  limit: 5                    # limit total number of items. Null or omit to show all (use paginate for paging)

#}
<section class="pagelist-longtile-section">
    {% if heading %}
    <div class="section-header">
        <h2 class="section-heading">{{ heading }}</h2>
    </div>
    {% endif %}
    
    {% if pages %}
    <div class="longtiles-grid">
        {% for page in pages %}
        <article class="page-longtile">
            <a href="{{ subfolder }}/{{ page.html_path.name }}" class="longtile-link">
                {% if image and page.frontmatter.image %}
                <div class="longtile-image">
                    <img src="/src/images/{{ page.frontmatter.image }}" alt="{{ page.frontmatter.title }}" class="longtile-img">
                </div>
                {% elif image %}
                <div class="longtile-image">
                    <img src="/src/images/logo.png" alt="{{ page.frontmatter.title }}" class="longtile-img">
                </div>
                {% endif %}
                
                <div class="longtile-content">
                    <h3 class="longtile-title">{{ page.frontmatter.title }}</h3>
                    
                    {% set highlight_keys = [] %}
                    {% for key in page.frontmatter.keys() %}
                        {% if key not in ['title', 'description', 'image', 'author', 'date', 'keywords', 'navs'] %}
                            {% set _ = highlight_keys.append(key) %}
                        {% endif %}
                    {% endfor %}
                    
                    {% if highlight_keys %}
                    <div class="longtile-highlights-container">
                        {% for highlight in highlight_keys %}
                        <span class="highlight-badge" title="{{ page.frontmatter[highlight] }}">{{ highlight }}</span>
                        {% endfor %}
                    </div>
                    {% endif %}
                    
                    {% if page.frontmatter.description %}
                    <p class="longtile-description">{{ page.frontmatter.description }}</p>
                    {% endif %}
                </div>
            </a>
        </article>
        {% endfor %}
    </div>
    {% endif %}
</section>